APP_NAME=Ukemochi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ukemochi
DB_USERNAME=ukemochi
DB_PASSWORD=ukemochi

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Hosts the PWAs are opened from (session cookie + CSRF). Add this PC's LAN IP and hostname.
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# First admin for `php artisan user:create-admin` / `db:seed`. Leave ADMIN_PIN blank to be asked for it.
ADMIN_NAME=admin
ADMIN_PIN=

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ID/key/secret are generated by `make` when it creates .env.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Server-to-server publishing (api -> reverb container). Browsers connect to wss://<host>/app/{key} via nginx.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
